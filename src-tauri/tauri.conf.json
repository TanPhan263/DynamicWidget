{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Islet",
  "version": "0.1.0",
  "identifier": "app.islet.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "island",
        "title": "Islet",
        "url": "island.html",
        "width": 1000,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Islet Settings",
        "url": "index.html",
        "width": 880,
        "height": 640,
        "minWidth": 600,
        "minHeight": 480,
        "visible": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "category": "Utility",
    "resources": { "../extension/": "extension/" },
    "shortDescription": "Dynamic Island-style notification center",
    "longDescription": "Islet adds an island at the top of your screen that shows notifications, live activities like timers and charging, and quick widgets. Scripts and tools can send notifications to it over a local HTTP API.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
